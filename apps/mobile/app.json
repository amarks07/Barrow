{
  "expo": {
    "name": "Barrow",
    "slug": "barrow",
    "version": "1.2.1",
    "scheme": "barrow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121214",
    "splash": {
      "backgroundColor": "#121214"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barrow.app"
    },
    "android": {
      "package": "com.barrow.app",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "themeColor": "#121214",
      "backgroundColor": "#121214"
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "./plugins/withNotifeeAndroidMavenRepo.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FocusWidget",
              "label": "Barrow Focus",
              "description": "Track sets for the workout open in Focus flow.",
              "minWidth": "220dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Barrow to use Face ID to quickly unlock your account."
        }
      ],
      "expo-audio",
      "expo-sharing",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Barrow to use the camera to scan a shared routine's QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Barrow to access your photos to set a profile picture.",
          "cameraPermission": "Allow Barrow to use the camera to take a profile picture.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9f2ec94-97d9-469e-baa5-eeb049d31192"
      }
    }
  }
}
