{
  "expo": {
    "name": "Barrow",
    "slug": "barrow",
    "version": "1.1.0",
    "scheme": "barrow",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121214",
    "splash": {
      "backgroundColor": "#121214"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.barrow.app"
    },
    "android": {
      "package": "com.barrow.app",
      "adaptiveIcon": {
        "backgroundColor": "#121214",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 3
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "./plugins/withNotifeeAndroidMavenRepo.js",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FocusWidget",
              "label": "Barrow Focus",
              "description": "Track sets for the workout open in Focus flow.",
              "minWidth": "220dp",
              "minHeight": "150dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "320dp",
              "maxResizeHeight": "420dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c9f2ec94-97d9-469e-baa5-eeb049d31192"
      }
    }
  }
}
