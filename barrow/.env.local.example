# Copy this file to .env.local and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API). Cloud backup is fully
# optional — without these set, the app runs exactly as before, entirely
# on local storage, and the Cloud Backup section in Profile stays hidden.
#
# The anon key is safe to expose to the client — it's the public key Row
# Level Security is designed to be used with (see supabase/schema.sql).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
